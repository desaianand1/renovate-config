{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    "mergeConfidence:all-badges",
    ":semanticCommits"
  ],
  "timezone": "America/Chicago",
  "schedule": ["* * 1-3 * *", "* * 15-17 * *"],
  "osvVulnerabilityAlerts": true,
  "minimumReleaseAge": "14 days",
  "internalChecksFilter": "strict",
  "rebaseWhen": "conflicted",
  "platformAutomerge": false,
  "prCreation": "not-pending",

  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": ["security"],
    "automerge": true,
    "automergeType": "pr",
    "semanticCommitType": "fix",
    "semanticCommitScope": "security"
  },

  "packageRules": [
    {
      "description": "Auto-merge Node.js Docker base image patches after 3-day hold",
      "matchManagers": ["dockerfile"],
      "matchDepNames": ["node"],
      "matchUpdateTypes": ["patch"],
      "automerge": true,
      "automergeType": "branch",
      "semanticCommitType": "fix",
      "semanticCommitScope": "deps",
      "minimumReleaseAge": "3 days"
    },
    {
      "description": "Auto-merge .node-version / .nvmrc patches after 3-day hold",
      "matchManagers": ["nvm", "nodenv"],
      "matchUpdateTypes": ["patch"],
      "automerge": true,
      "automergeType": "branch",
      "semanticCommitType": "fix",
      "semanticCommitScope": "deps",
      "minimumReleaseAge": "3 days"
    },
    {
      "description": "Auto-merge GitHub Actions digest/patch updates (CI supply chain)",
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["patch", "digest"],
      "automerge": true,
      "automergeType": "branch",
      "semanticCommitType": "ci",
      "semanticCommitScope": "deps"
    },
    {
      "description": "Auto-merge dev dependency patches after 14-day hold",
      "matchDepTypes": ["devDependencies"],
      "matchUpdateTypes": ["patch"],
      "automerge": true,
      "automergeType": "branch"
    },
    {
      "description": "Require dashboard approval for ALL major updates",
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true,
      "automerge": false
    },
    {
      "description": "Disable routine npm production dependency minor/patch (noise)",
      "matchManagers": ["npm"],
      "matchDepTypes": ["dependencies"],
      "matchUpdateTypes": ["minor", "patch"],
      "enabled": false
    },
    {
      "description": "Always allow npm vulnerability fixes (overrides disable above)",
      "matchCategories": ["security"],
      "enabled": true,
      "automerge": true,
      "semanticCommitType": "fix",
      "semanticCommitScope": "security"
    },
    {
      "description": "Docker major version bumps need manual review",
      "matchManagers": ["dockerfile"],
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true,
      "automerge": false
    }
  ]
}
